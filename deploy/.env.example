# Production settings for /srv/redreader/.env on the server. Never commit the real file.
# bootstrap.sh fills the generated secrets (marked [generated]); fill the rest by hand.

# Real users: Google sign-in only, no seeded or sample data. Don't change on the production server.
APP_ENV=production

SITE_DOMAIN=redreader.in
WEB_ORIGIN=https://redreader.in
TAG=latest

# [generated] Database, search and admin-portal secrets.
POSTGRES_PASSWORD=
MEILI_KEY=
OPS_EMAIL=ops@redreader.in
OPS_PASSWORD=

# Google sign-in (Google Cloud Console → Credentials → OAuth client "Web application").
# Authorised redirect URI: https://redreader.in/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email via Amazon SES SMTP (SES console → SMTP settings → Create SMTP credentials).
# smtp://<smtp-username>:<url-encoded-smtp-password>@email-smtp.ap-southeast-2.amazonaws.com:587
SMTP_URL=
MAIL_FROM="RedReader <hello@redreader.in>"

# Comma-separated emails that get moderation access when they sign in.
ADMIN_EMAILS=

# Optional integrations.
AMAZON_ASSOCIATE_TAG=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

