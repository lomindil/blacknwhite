# HTTPS front door. Cloudflare proxies the site; Caddy serves a Cloudflare Origin Certificate
# (deploy/certs/origin.pem + origin.key, created in the Cloudflare dashboard) with SSL mode "Full (strict)".
{
	servers {
		# Only trust the visitor IP Cloudflare sends when the request really comes from Cloudflare.
		# Ranges from https://www.cloudflare.com/ips/ — refresh with deploy/scripts/cloudflare-ips.sh.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(proxy_headers) {
	# One trustworthy hop for the app (Express trusts exactly one proxy).
	header_up X-Forwarded-For {client_ip}
}

www.{$SITE_DOMAIN} {
	tls /certs/origin.pem /certs/origin.key
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip

	# Browser API calls: /api/x → API /x
	handle_path /api/* {
		reverse_proxy api:4000 {
			import proxy_headers
		}
	}
	# Sign-in, photos, realtime and the health check go to the API as-is.
	@api path /auth/* /media/* /ws /ws/* /health
	handle @api {
		reverse_proxy api:4000 {
			import proxy_headers
		}
	}
	# Everything else is the Next.js site.
	handle {
		reverse_proxy web:3000 {
			import proxy_headers
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format console
	}
}
