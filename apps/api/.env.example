NODE_ENV=development
PORT=4000

# Services from docker-compose.yml
DATABASE_URL=postgresql://bnw:bnw@localhost:5433/bnw?schema=public
REDIS_URL=redis://localhost:6380
MEILI_URL=http://localhost:7700
MEILI_KEY=dev_master_key_change_me
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Book Club <hello@example.com>"

# The web app origin. The web app proxies /api/* and /auth/* to this API.
WEB_ORIGIN=http://localhost:3000

# Google OAuth (Google Cloud Console → Credentials → OAuth client, type "Web application").
# Authorised redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev-only email sign-in, for when Google credentials aren't set up. Never enable in production.
DEV_LOGIN=true

# Comma-separated emails that get admin (moderation) access on sign-in.
ADMIN_EMAILS=

# WhatsApp Cloud API. Leave blank in dev: messages are logged instead of sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Amazon Associates tag for buy links (e.g. yourtag-21).
AMAZON_ASSOCIATE_TAG=

# Run background jobs inside the API process (saves memory in dev). Use a separate worker in production.
RUN_WORKER_IN_API=true

# Uploaded photos: where files are written, and the public URL prefix (the web app proxies /media).
UPLOAD_DIR=uploads
MEDIA_BASE_URL=/media

# Admin portal (/ops) sign-in. Change both before deploying — the API refuses to start in production with the default password.
OPS_EMAIL=ops@bookclub.local
OPS_PASSWORD=ChangeMe-ops-2026
