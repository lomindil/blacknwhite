{
  "name": "@bnw/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "nest build && node dist/scripts/seed.js",
    "search:reindex": "node dist/scripts/reindex.js",
    "genres:backfill": "nest build && node dist/scripts/backfill-genres.js",
    "books:enrich": "nest build && node dist/scripts/enrich-books.js"
  },
  "dependencies": {
    "@bnw/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/websockets": "11.2.7",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "csv-parse": "5.6.0",
    "dotenv": "16.6.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "multer": "2.4.0",
    "nodemailer": "7.0.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.24",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testTimeout": 30000
  }
}
